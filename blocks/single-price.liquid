{%- assign group_product 			= product.metafields.bwp_fields.group_product -%}
{%- assign current_variant 			= product.selected_or_first_available_variant -%}
{%- if group_product != blank -%}
    <div class="price-container" style="margin:{{ block.settings.product_price_margin }};--price-color:{{ block.settings.price_color }};--price-color-sale:{{ block.settings.price_color_sale }};--price-font-size:{{ block.settings.price_size }}px;">
        {% for product_group in group_product.value %}
            {%- for variant in product_group.variants -%}
                {% assign prices =  prices | append: variant.price | append: ',' %}
            {% endfor %}
        {% endfor %}
        {% assign operator_prices	= prices | split: "," %}
        {% assign min_price = operator_prices[0] | plus: 0 %}
        {% assign max_price = operator_prices[0] | plus: 0 %}
        {% for operator_price in operator_prices %}
            {% assign operator = operator_price | plus: 0 %}
            {% assign min_price		 = min_price | plus: 0 %}
            {% assign max_price		 = max_price | plus: 0 %}
            {% if operator < min_price %}
                {% assign min_price = operator %}
            {% endif %}
            {% if operator > max_price %}
                {% assign max_price = operator %}
            {% endif %}		
        {% endfor %}
        {{  min_price | money }} - {{  max_price | money }}
    </div>
{% else %}
    {%- comment -%} BM: optional per-product note after the price, from the product metafield custom.price_note (e.g. "for pack of 2") {%- endcomment -%}
    {%- assign price_note = product.metafields.custom.price_note.value -%}
    <div class="price-single-product{% if price_note != blank %} bm-has-price-note{% endif %}" style="margin:{{ block.settings.product_price_margin }};--price-color:{{ block.settings.price_color }};--price-color-sale:{{ block.settings.price_color_sale }};--price-font-size:{{ block.settings.price_size }}px;">
        {% render 'product-price', variant: current_variant %}
        {%- if price_note != blank -%}
            <span class="bm-price-note">{{ price_note | escape }}</span>
        {%- endif -%}
    </div>
    {%- if price_note != blank -%}
    <style>
      .price-single-product.bm-has-price-note {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        column-gap: 10px;
      }
      .price-single-product .bm-price-note {
        font-family: var(--font-family-base), 'Manrope', sans-serif;
        font-size: 15px;
        color: #666666;
      }
    </style>
    {%- endif -%}
{% endif %}
{% schema %}
  {
    "name": "Single product price",
    "settings": [
        {
            "type": "text",
            "id": "product_price_margin",
            "label": "Margin",
            "info": "Example(top left bottom right): 15px 15px 15px 15px",
            "default":"10px 0 17px"
        },
        {
            "type": "number",
            "id": "price_size",
            "label": "Font size",
            "info": "px",
            "default":25
        },
        {
            "type": "color",
            "id": "price_color",
            "label": "Color",
            "default":"#ed5d43"
        },
        {
            "type": "color",
            "id": "price_color_sale",
            "label": "Color sale",
            "default":"#ff0000"
        }
    ],
    "presets": [{"name": "Single product price","category": "Single product"}]
  }
{% endschema %}