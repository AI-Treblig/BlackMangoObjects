{%- comment -%}
  Black Mango — product feature bullet list.
  Add this block inside the product info column. Each feature line is its own
  editable field in the backend (up to 8). Empty lines are skipped.
{%- endcomment -%}

<div class="bm-feature-list"
     id="bm-feature-list-{{ block.id }}"
     style="margin: {{ block.settings.margin | default: '0 0 24px' }};">
  {%- if block.settings.heading != blank -%}
    <p class="bm-feature-list__heading">{{ block.settings.heading }}</p>
  {%- endif -%}
  <ul class="bm-feature-list__items">
    {%- for i in (1..8) -%}
      {%- assign key = 'feature_' | append: i -%}
      {%- assign val = block.settings[key] -%}
      {%- if val != blank -%}
        <li class="bm-feature-list__item">{{ val }}</li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

<style>
  #bm-feature-list-{{ block.id }} .bm-feature-list__heading {
    font-family: var({{ block.settings.heading_font | default: '--font-family-second' }}), serif;
    font-size: {{ block.settings.heading_size | default: 16 }}px;
    color: {{ block.settings.heading_color | default: '#000000' }};
    text-transform: {{ block.settings.heading_transform | default: 'none' }};
    letter-spacing: {{ block.settings.heading_letter_spacing | default: 0 }}px;
    margin: 0 0 12px;
    font-weight: {{ block.settings.heading_weight | default: '500' }};
  }
  #bm-feature-list-{{ block.id }} .bm-feature-list__items {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #bm-feature-list-{{ block.id }} .bm-feature-list__item {
    position: relative;
    padding-left: {{ block.settings.indent | default: 22 }}px;
    margin-bottom: {{ block.settings.item_spacing | default: 10 }}px;
    font-family: var({{ block.settings.font | default: '--font-family-base' }}), sans-serif;
    font-size: {{ block.settings.font_size | default: 15 }}px;
    line-height: {{ block.settings.line_height | default: 1.5 }};
    color: {{ block.settings.color | default: '#666666' }};
    letter-spacing: {{ block.settings.letter_spacing | default: 0 }}px;
  }
  #bm-feature-list-{{ block.id }} .bm-feature-list__item::before {
    content: '{{ block.settings.bullet_char | default: '•' }}';
    position: absolute;
    left: 0;
    top: 0;
    color: {{ block.settings.bullet_color | default: '#000000' }};
    font-size: {{ block.settings.bullet_size | default: 15 }}px;
    line-height: {{ block.settings.line_height | default: 1.5 }};
  }
  @media (max-width: 767px) {
    #bm-feature-list-{{ block.id }} {
      {%- if block.settings.margin_mobi != blank -%}margin: {{ block.settings.margin_mobi }} !important;{%- endif -%}
    }
    #bm-feature-list-{{ block.id }} .bm-feature-list__heading {
      font-size: {{ block.settings.heading_size_mobi | default: 15 }}px;
    }
    #bm-feature-list-{{ block.id }} .bm-feature-list__item {
      font-size: {{ block.settings.font_size_mobi | default: 14 }}px;
    }
    #bm-feature-list-{{ block.id }} .bm-feature-list__item::before {
      font-size: {{ block.settings.font_size_mobi | default: 14 }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Single feature list",
  "settings": [
    { "type": "header", "content": "Heading (optional)" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to hide" },

    { "type": "header", "content": "Feature lines", "info": "Each filled line shows as a bullet. Leave blank to skip." },
    { "type": "text", "id": "feature_1", "label": "Feature 1", "default": "Hand tufted premium finish" },
    { "type": "text", "id": "feature_2", "label": "Feature 2", "default": "Made with New Zealand wool" },
    { "type": "text", "id": "feature_3", "label": "Feature 3", "default": "Soft underfoot and durable" },
    { "type": "text", "id": "feature_4", "label": "Feature 4", "default": "Designed for modern interiors" },
    { "type": "text", "id": "feature_5", "label": "Feature 5", "default": "Available in multiple sizes" },
    { "type": "text", "id": "feature_6", "label": "Feature 6" },
    { "type": "text", "id": "feature_7", "label": "Feature 7" },
    { "type": "text", "id": "feature_8", "label": "Feature 8" },

    { "type": "header", "content": "Bullet style" },
    { "type": "text", "id": "bullet_char", "label": "Bullet character", "default": "•", "info": "e.g. •  –  ◦  ✓  ✦" },
    { "type": "color", "id": "bullet_color", "label": "Bullet color", "default": "#000000" },
    { "type": "range", "id": "bullet_size", "label": "Bullet size (px)", "min": 8, "max": 28, "step": 1, "default": 15 },
    { "type": "range", "id": "indent", "label": "Text indent (px)", "min": 10, "max": 40, "step": 1, "default": 22 },

    { "type": "header", "content": "Heading typography" },
    { "type": "select", "id": "heading_font", "label": "Heading font",
      "options": [
        { "value": "--font-family-second", "label": "Heading font" },
        { "value": "--font-family-base", "label": "Body font" }
      ],
      "default": "--font-family-second"
    },
    { "type": "range", "id": "heading_size", "label": "Heading size (px)", "min": 12, "max": 28, "step": 1, "default": 16 },
    { "type": "range", "id": "heading_size_mobi", "label": "Heading size — mobile (px)", "min": 11, "max": 24, "step": 1, "default": 15 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#000000" },
    { "type": "select", "id": "heading_weight", "label": "Heading weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    { "type": "select", "id": "heading_transform", "label": "Heading case",
      "options": [
        { "value": "none", "label": "Original" },
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "capitalize", "label": "Capitalized" }
      ],
      "default": "none"
    },
    { "type": "range", "id": "heading_letter_spacing", "label": "Heading letter spacing (px)", "min": 0, "max": 4, "step": 0.5, "default": 0 },

    { "type": "header", "content": "Feature text typography" },
    { "type": "select", "id": "font", "label": "Feature font",
      "options": [
        { "value": "--font-family-base", "label": "Body font" },
        { "value": "--font-family-second", "label": "Heading font" }
      ],
      "default": "--font-family-base"
    },
    { "type": "range", "id": "font_size", "label": "Feature font size (px)", "min": 11, "max": 22, "step": 1, "default": 15 },
    { "type": "range", "id": "font_size_mobi", "label": "Feature font size — mobile (px)", "min": 10, "max": 20, "step": 1, "default": 14 },
    { "type": "color", "id": "color", "label": "Feature text color", "default": "#666666" },
    { "type": "range", "id": "line_height", "label": "Line height", "min": 1, "max": 2.4, "step": 0.1, "default": 1.5 },
    { "type": "range", "id": "letter_spacing", "label": "Letter spacing (px)", "min": 0, "max": 3, "step": 0.5, "default": 0 },
    { "type": "range", "id": "item_spacing", "label": "Space between items (px)", "min": 0, "max": 30, "step": 1, "default": 10 },

    { "type": "header", "content": "Spacing" },
    { "type": "text", "id": "margin", "label": "Margin", "default": "0 0 24px", "info": "Top right bottom left" },
    { "type": "text", "id": "margin_mobi", "label": "Margin (mobile)", "info": "Top right bottom left" }
  ],
  "presets": [{ "name": "Single feature list", "category": "Single product" }]
}
{% endschema %}
